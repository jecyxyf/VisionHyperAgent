{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "npx rfc2119@0.7.0 hook after-edit --platform codex"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx rfc2119@0.7.0 hook stop --platform codex"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx rfc2119@0.7.0 hook session-start --platform codex"
          }
        ]
      }
    ]
  }
}
