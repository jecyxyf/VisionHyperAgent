import { Theme } from "../theme.slint";
import { GlassPanel, IconButton, InfoRow } from "../components/controls.slint";
import { WorkspaceHeader } from "../components/workspace.slint";

export component SettingsPage inherits Rectangle {
    callback preview-action(string);
    VerticalLayout {
        spacing: 12px;
        WorkspaceHeader {
            title: "设置";
            IconButton { label: "配置连接"; icon: @image-url("../resources/ui/icons/settings.svg"); activated => { root.preview-action("连接配置暂不可用。"); } }
        }
        GlassPanel {
            height: 282px;
            VerticalLayout {
                padding: 16px; spacing: 4px;
                Text { text: "连接与运行环境"; color: Theme.text; font-size: 0.95rem; font-weight: 600; }
                InfoRow { label: "大模型服务"; value: "未配置"; }
                InfoRow { label: "Codex"; value: "未连接"; }
                InfoRow { label: "Python 训练环境"; value: "未安装"; }
                InfoRow { label: "NVIDIA 设备"; value: "未检测"; }
                InfoRow { label: "外部通信"; value: "ZeroMQ · 未连接"; }
            }
        }
        Rectangle { vertical-stretch: 1; }
    }
}

export component AboutPage inherits Rectangle {
    VerticalLayout {
        spacing: 12px;
        WorkspaceHeader { title: "关于"; }
        GlassPanel {
            height: 200px;
            VerticalLayout {
                padding: 28px; spacing: 16px;
                HorizontalLayout {
                    spacing: 16px; cross-axis-alignment: center;
                    Rectangle {
                        width: 48px; height: 48px; border-radius: 14px; background: Theme.accent-surface;
                        Image { width: 26px; height: 26px; source: @image-url("../resources/ui/icons/scan.svg"); colorize: Theme.accent; }
                    }
                    VerticalLayout {
                        spacing: 5px;
                        Text { text: "VisionHyperAgent"; color: Theme.text; font-size: 1.45rem; font-weight: 600; }
                        Text { text: "Agent 驱动的视觉模型工作台"; color: Theme.muted; font-size: 0.88rem; }
                    }
                }
                Rectangle { height: 1px; background: Theme.border; }
                Text { text: "本地训练 · 离线识别"; color: Theme.muted; font-size: 0.86rem; }
            }
        }
        Rectangle { vertical-stretch: 1; }
    }
}
