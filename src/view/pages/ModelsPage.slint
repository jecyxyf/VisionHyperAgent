import { SplitArea } from "../ui_items/SplitArea.slint";
import { Splitter } from "../ui_items/Splitter.slint";
import { ModelEntry } from "../ui_items/ViewTypes.slint";
import { WorkspaceHeader } from "../components/WorkspaceHeader.slint";
import { IconButton } from "../components/IconButton.slint";
import { GlassPanel } from "../components/GlassPanel.slint";
import { Theme } from "../ui_items/Theme.slint";
import { ModelCells } from "../components/ModelCells.slint";
import { EmptyState } from "../components/EmptyState.slint";
import { ScrollView } from "std-widgets.slint";
import { ModelRow } from "../components/ModelRow.slint";

export component ModelsPage inherits Rectangle {
    in property <string> directory;
    in property <[ModelEntry]> entries;
    in-out property <int> selected-index: -1;
    callback preview-action(string);
    in-out property <length> details-height: 112px;
    private property <bool> has-selection: root.selected-index >= 0 && root.selected-index < root.entries.length;
    VerticalLayout {
        spacing: 16px;
        WorkspaceHeader {
            icon: @image-url("../resources/ui/icons/train.svg");
            title: "模型";
            IconButton {
                label: "选择模型目录";
                icon: @image-url("../resources/ui/icons/folder.svg");
                activated => { root.preview-action("暂时无法选择模型目录。"); }
            }

            IconButton {
                label: "刷新模型列表";
                icon: @image-url("../resources/ui/icons/refresh.svg");
                activated => { root.preview-action("暂时无法读取模型目录。"); }
            }
        }

        GlassPanel {
            inset: true;
            height: 48px;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 10px;
                cross-axis-alignment: center;
                Image {
                    source: @image-url("../resources/ui/icons/folder.svg");
                    width: 16px;
                    height: 16px;
                    colorize: Theme.muted;
                }

                Text {
                    text: root.directory == "" ? "未选择模型目录" : root.directory;
                    color: Theme.muted;
                    font-size: 0.9rem;
                    min-width: 0px;
                    horizontal-stretch: 1;
                    overflow: elide;
                }

                Text {
                    text: "\{root.entries.length} 个模型";
                    color: Theme.subdued;
                    font-size: 0.8rem;
                }
            }
        }

        models-body := SplitArea {
            vertical-stretch: 1;

            GlassPanel {
                inset: true;
                x: 0px;
                y: 0px;
                width: parent.width;
                height: root.has-selection ? max(0px, parent.height - 12px - details-splitter.position) : parent.height;

                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;
                    ModelCells {
                        height: 24px;
                        header: true;
                        entry: { name: "模型名称", format: "格式", path: "文件位置" };
                    }

                    Rectangle {
                        height: 1px;
                        background: Theme.border;
                    }

                    if root.entries.length == 0: EmptyState {
                        vertical-stretch: 1;
                        icon: @image-url("../resources/ui/icons/train.svg");
                        title: "暂无模型";
                    }
                    if root.entries.length > 0: ScrollView {
                        vertical-stretch: 1;
                        viewport-width: self.width;
                        VerticalLayout {
                            spacing: 4px;
                            for item[index] in root.entries: ModelRow {
                                entry: item;
                                selected: root.selected-index == index;
                                activated => { root.selected-index = index; }
                            }
                            Rectangle {
                                vertical-stretch: 1;
                            }
                        }
                    }
                }
            }

            details-splitter := Splitter {
                x: 0px;
                y: parent.height - 12px - self.position;
                width: parent.width;
                height: root.has-selection ? 12px : 0px;
                visible: root.has-selection;
                enabled: root.has-selection;
                thickness: root.has-selection ? 12px : 0px;
                reverse: true;
                label: "模型详情高度";
                value: root.details-height;
                minimum: 112px;
                maximum: models-body.height - 12px - 180px;
                resized(size) => { root.details-height = size; }
            }

            if root.has-selection: GlassPanel {
                inset: true;
                x: 0px;
                y: parent.height - details-splitter.position;
                width: parent.width;
                height: details-splitter.position;
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    Text {
                        text: root.entries[root.selected-index].name;
                        color: Theme.text;
                        font-size: 0.95rem;
                        font-weight: 500;
                        overflow: elide;
                    }

                    Text {
                        text: root.entries[root.selected-index].path;
                        color: Theme.muted;
                        font-size: 0.84rem;
                        overflow: elide;
                    }

                    Text {
                        text: "格式  ·  " + root.entries[root.selected-index].format;
                        color: Theme.subdued;
                        font-size: 0.78rem;
                    }
                }
            }
        }
    }
}
