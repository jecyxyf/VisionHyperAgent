import { SplitArea } from "../ui_items/SplitArea.slint";
import { Splitter } from "../ui_items/Splitter.slint";
import { TrainingDraft } from "../ui_items/ViewTypes.slint";
import { WorkspaceHeader } from "../components/WorkspaceHeader.slint";
import { IconButton } from "../components/IconButton.slint";
import { ToolbarDivider } from "../components/ToolbarDivider.slint";
import { GlassPanel } from "../components/GlassPanel.slint";
import { Theme } from "../ui_items/Theme.slint";
import { ScrollView, CheckBox } from "std-widgets.slint";
import { DraftField } from "../components/DraftField.slint";
import { EmptyChart } from "../components/EmptyChart.slint";

export component TrainingPage inherits Rectangle {
    callback preview-action(string);
    in-out property <TrainingDraft> draft;
    in-out property <length> parameters-width: 210px;
    in-out property <length> log-height: 114px;
    in-out property <float> loss-ratio: 0.5;
    VerticalLayout {
        spacing: 16px;
        WorkspaceHeader {
            icon: @image-url("../resources/ui/icons/train.svg");
            title: "训练";
            IconButton {
                label: "Agent 建议参数";
                icon: @image-url("../resources/ui/icons/spark.svg");
                activated => { root.preview-action("Agent 未连接，无法生成参数建议。"); }
            }

            ToolbarDivider { }

            IconButton {
                label: "停止训练";
                icon: @image-url("../resources/ui/icons/stop.svg");
                activated => { root.preview-action("没有正在执行的训练任务。"); }
            }

            IconButton {
                label: "开始训练";
                icon: @image-url("../resources/ui/icons/play.svg");

                activated => { root.preview-action("训练功能暂不可用。"); }
            }
        }

        SplitArea {

            GlassPanel {
                inset: true;
                x: 0px;
                y: 0px;
                height: parent.height;
                width: parameters-splitter.position;
                VerticalLayout {
                    padding: 16px;
                    spacing: 14px;
                    Text {
                        text: "训练参数";
                        color: Theme.text;
                        font-size: 0.95rem;
                        font-weight: 600;
                    }

                    Text {
                        text: "未选择数据集";
                        color: Theme.subdued;
                        font-size: 0.78rem;
                        wrap: word-wrap;
                    }

                    Rectangle {
                        height: 1px;
                        background: Theme.border;
                    }

                    ScrollView {
                        vertical-stretch: 1;
                        viewport-width: self.width;
                        VerticalLayout {
                            spacing: 14px;
                            DraftField {
                                label: "训练轮数  /  Epochs";
                                value <=> root.draft.epochs;
                            }

                            DraftField {
                                label: "批次大小  /  Batch";
                                value <=> root.draft.batch;
                            }

                            DraftField {
                                label: "图像尺寸  /  Image size";
                                value <=> root.draft.image-size;
                            }

                            DraftField {
                                label: "学习率  /  Learning rate";
                                value <=> root.draft.learning-rate;
                            }

                            Rectangle {
                                height: 1px;
                                background: Theme.border;
                            }

                            CheckBox {
                                text: "Agent 自动调参";
                                checked <=> root.draft.automatic;
                            }

                            Rectangle {
                                vertical-stretch: 1;
                            }
                        }
                    }
                }
            }

            parameters-splitter := Splitter {
                x: self.position;
                y: 0px;
                width: 12px;
                height: parent.height;
                vertical: true;
                label: "训练参数宽度";
                value: root.parameters-width;
                minimum: 180px;
                maximum: root.width - 12px - 280px;
                resized(size) => { root.parameters-width = size; }
            }

            effects-column := SplitArea {
                x: parameters-splitter.position + 12px;
                y: 0px;
                width: max(0px, parent.width - 12px - parameters-splitter.position);
                height: parent.height;
                horizontal-stretch: 1;

                GlassPanel {
                    inset: true;
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: max(0px, parent.height - 12px - log-splitter.position);

                    VerticalLayout {
                        padding: 16px;
                        spacing: 12px;
                        HorizontalLayout {
                            Text {
                                text: "训练效果";
                                color: Theme.text;
                                font-size: 0.95rem;
                                font-weight: 600;
                                horizontal-stretch: 1;
                            }

                            Text {
                                text: "未开始";
                                color: Theme.subdued;
                                font-size: 0.78rem;
                            }
                        }

                        charts := SplitArea {
                            vertical-stretch: 1;

                            EmptyChart {
                                x: 0px;
                                y: 0px;
                                width: parent.width;
                                title: "损失  /  Loss";
                                detail: "暂无数据";
                                height: loss-splitter.position;
                            }

                            loss-splitter := Splitter {
                                x: 0px;
                                y: self.position;
                                width: parent.width;
                                height: 12px;
                                label: "损失曲线高度";
                                value: (charts.height - 12px) * root.loss-ratio;
                                minimum: 130px;
                                maximum: charts.height - 12px - 130px;
                                resized(size) => { root.loss-ratio = size / max(1px, charts.height - 12px); }
                            }

                            EmptyChart {
                                x: 0px;
                                y: loss-splitter.position + 12px;
                                width: parent.width;
                                height: max(0px, parent.height - 12px - loss-splitter.position);
                                title: "评估指标";
                                detail: "暂无数据";
                            }
                        }
                    }
                }

                log-splitter := Splitter {
                    x: 0px;
                    y: parent.height - 12px - self.position;
                    width: parent.width;
                    height: 12px;
                    reverse: true;
                    label: "训练任务日志高度";
                    value: root.log-height;
                    minimum: 96px;
                    maximum: effects-column.height - 12px - 352px;
                    resized(size) => { root.log-height = size; }
                }

                GlassPanel {
                    inset: true;
                    x: 0px;
                    y: parent.height - log-splitter.position;
                    width: parent.width;
                    height: log-splitter.position;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 10px;
                        Text {
                            text: "任务日志";
                            color: Theme.text;
                            font-size: 0.9rem;
                            font-weight: 500;
                        }

                        Text {
                            text: "暂无日志";
                            color: Theme.subdued;
                            font-size: 0.79rem;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }
}
