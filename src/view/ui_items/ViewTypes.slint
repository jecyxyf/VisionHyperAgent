export enum ViewPage { inference, models, preannotation, annotation, pretraining, training, settings, about }

// Pane preferences; the Rust host persists normalized ratios in parameters.json.
// Negative outer widths mean automatic 1:8:4 sizing.
export struct PaneLayout {
    navigation-width: length,
    agent-width: length,
    inference-records-height: length,
    models-details-height: length,
    annotation-list-width: length,
    preannotation-editor-width: length,
    preannotation-analysis-ratio: float,
    training-parameters-width: length,
    training-log-height: length,
    training-loss-ratio: float,
    chat-composer-height: length,
}

// Populated by a future directory adapter; the UI never invents model files.
export struct ModelEntry {
    name: string,
    format: string,
    path: string,
}

export struct FeatureDraft {
    target: string,
    appearance: string,
    distinctions: string,
    exclusions: string,
}

// UI drafts only. No configuration is sent to a business service yet.
export struct TrainingDraft {
    epochs: string,
    batch: string,
    image-size: string,
    learning-rate: string,
    automatic: bool,
}
