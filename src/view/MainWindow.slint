import { SplitArea } from "ui_items/SplitArea.slint";
import "resources/ui/fonts/NotoSansCJK-Regular.ttc";
import { Theme } from "Theme.slint";
import { Palette } from "std-widgets.slint";
import {
    ViewPage,
    ModelEntry,
    FeatureDraft,
    TrainingDraft,
    PaneLayout,
} from "ViewTypes.slint";
import { UiHints } from "UiHints.slint";
import { AppHeader } from "components/AppHeader.slint";
import { GlassPanel } from "components/GlassPanel.slint";
import { NavItem } from "components/NavItem.slint";
import { ExpandableNavItem } from "components/ExpandableNavItem.slint";
import { InferencePage } from "pages/InferencePage.slint";
import { ModelsPage } from "pages/ModelsPage.slint";
import { PreannotationPage } from "pages/PreannotationPage.slint";
import { PretrainingPage } from "pages/PretrainingPage.slint";
import { AnnotationPage } from "pages/AnnotationPage.slint";
import { TrainingPage } from "pages/TrainingPage.slint";
import { SettingsPage } from "pages/SettingsPage.slint";
import { AboutPage } from "pages/AboutPage.slint";
import { GlobalChat } from "components/GlobalChat.slint";
import { IconButton } from "components/IconButton.slint";
import { Splitter } from "ui_items/Splitter.slint";

export component MainWindow inherits Window {
    title: "VisionHyperAgent";
    preferred-width: 1440px;
    preferred-height: 900px;
    min-width: 1120px;
    min-height: 720px;
    default-font-family: "Noto Sans CJK SC";
    default-font-size: 14px;
    background: Theme.background;
    init => { Palette.color-scheme = ColorScheme.light; }

    in-out property <ViewPage> current-page: ViewPage.inference;
    callback page-requested(ViewPage);
    // Standalone Viewer fallback; the Rust host replaces this handler with ViewModel binding.
    page-requested(page) => { root.current-page = page; }
    in-out property <PaneLayout> pane-layout: {
        navigation-width: -1px,
        agent-width: -1px,
        inference-records-height: 138px,
        models-details-height: 112px,
        annotation-list-width: 116px,
        preannotation-editor-width: 300px,
        preannotation-analysis-ratio: 0.5,
        training-parameters-width: 210px,
        training-log-height: 114px,
        training-loss-ratio: 0.5,
        chat-composer-height: 132px,
    };
    in-out property <bool> models-expanded: true;
    in-out property <string> models-directory;
    in-out property <[ModelEntry]> model-entries;
    in-out property <int> selected-model: -1;
    in-out property <string> chat-draft;
    in-out property <string> last-message;
    in-out property <int> source-choice: 0;
    // Runtime model choice is separate from highlighting a record in the model library.
    in-out property <string> inference-model-name;
    in-out property <bool> annotation-grid: true;
    in-out property <FeatureDraft> feature-draft: {
        target: "",
        appearance: "",
        distinctions: "",
        exclusions: "",
    };
    // Analysis is supplied by the future Agent adapter, never generated by the preview.
    in-out property <string> feature-analysis;
    in-out property <string> feature-rules;
    in-out property <bool> feature-confirmed: false;
    changed feature-draft => {
        root.feature-analysis = "";
        root.feature-rules = "";
        root.feature-confirmed = false;
    }
    in-out property <TrainingDraft> training-draft: {
        epochs: "",
        batch: "",
        image-size: "",
        learning-rate: "",
        automatic: true,
    };
    in-out property <string> feedback;
    private property <string> page-label:
        root.current-page == ViewPage.inference ? "运行" :
        root.current-page == ViewPage.models ? "模型" :
        root.current-page == ViewPage.preannotation ? "预标注" :
        root.current-page == ViewPage.annotation ? "标注" :
        root.current-page == ViewPage.pretraining ? "预训练" :
        root.current-page == ViewPage.training ? "训练" :
        root.current-page == ViewPage.settings ? "设置" : "关于";
    changed current-page => { UiHints.text = ""; }
    function show-notice(message: string) {
        root.feedback = message;
        notice-timer.restart();
    }
    notice-timer := Timer {
        interval: 5s;
        triggered => { root.feedback = ""; self.stop(); }
    }

    // Soft ambient gradients beneath translucent surfaces; no OS backdrop blur required.
    Image {
        source: @image-url("resources/ui/ambient.svg");
        width: 100%;
        height: 100%;
        image-fit: fill;
    }

    VerticalLayout {
        spacing: 0px;
        padding-bottom: 16px;
        AppHeader { }

        SplitArea {

            GlassPanel {
                x: 16px;
                y: 0px;
                height: parent.height;
                width: navigation-splitter.position;
                background: Theme.surface;
                VerticalLayout {
                    padding: 10px;
                    padding-top: 16px;
                    spacing: 6px;
                    NavItem {
                        text: "运行";
                        icon: @image-url("resources/ui/icons/play.svg");
                        selected: root.current-page == ViewPage.inference;
                        activated => { root.page-requested(ViewPage.inference); }
                    }

                    Rectangle {
                        height: 14px;
                    }

                    ExpandableNavItem {
                        text: "模型";
                        icon: @image-url("resources/ui/icons/train.svg");
                        expanded: root.models-expanded;
                        selected: root.current-page == ViewPage.models ||
                            (!root.models-expanded && (root.current-page == ViewPage.preannotation || root.current-page == ViewPage.annotation || root.current-page == ViewPage.pretraining || root.current-page == ViewPage.training));
                        activated => { root.page-requested(ViewPage.models); }
                        toggle-expanded => { root.models-expanded = !root.models-expanded; UiHints.text = ""; }
                    }

                    if root.models-expanded: NavItem {
                        text: "预标注";
                        nested: true;
                        selected: root.current-page == ViewPage.preannotation;
                        activated => { root.page-requested(ViewPage.preannotation); }
                    }
                    if root.models-expanded: NavItem {
                        text: "标注";
                        nested: true;
                        selected: root.current-page == ViewPage.annotation;
                        activated => { root.page-requested(ViewPage.annotation); }
                    }
                    if root.models-expanded: NavItem {
                        text: "预训练";
                        nested: true;
                        selected: root.current-page == ViewPage.pretraining;
                        activated => { root.page-requested(ViewPage.pretraining); }
                    }
                    if root.models-expanded: NavItem {
                        text: "训练";
                        nested: true;
                        selected: root.current-page == ViewPage.training;
                        activated => { root.page-requested(ViewPage.training); }
                    }
                    Rectangle {
                        vertical-stretch: 1;
                    }

                    Rectangle {
                        height: 8px;
                    }

                    NavItem {
                        text: "设置";
                        icon: @image-url("resources/ui/icons/settings.svg");
                        selected: root.current-page == ViewPage.settings;
                        activated => { root.page-requested(ViewPage.settings); }
                    }

                    NavItem {
                        text: "关于";
                        icon: @image-url("resources/ui/icons/about.svg");
                        selected: root.current-page == ViewPage.about;
                        activated => { root.page-requested(ViewPage.about); }
                    }
                }
            }

            navigation-splitter := Splitter {
                x: 16px + self.position;
                y: 0px;
                width: 16px;
                height: parent.height;
                vertical: true;
                thickness: 16px;
                label: "导航宽度";
                value: root.pane-layout.navigation-width < 0px ? (root.width - 64px) / 13 : root.pane-layout.navigation-width;
                minimum: 140px;
                maximum: root.width - 64px - 540px - 260px;
                resized(size) => { root.pane-layout.navigation-width = size; }
            }

            GlassPanel {
                x: 32px + navigation-splitter.position;
                y: 0px;
                height: parent.height;
                width: max(0px, root.width - 64px - navigation-splitter.position - agent-splitter.position);
                // Page title, toolbar and content share the same outer frame as Agent.
                Rectangle {
                    x: 18px;
                    y: 18px;
                    width: max(0px, parent.width - 36px);
                    height: max(0px, parent.height - 36px);
                    if root.current-page == ViewPage.inference: InferencePage {
                        model-name: root.inference-model-name;
                        source-choice <=> root.source-choice;
                        records-height <=> root.pane-layout.inference-records-height;
                        preview-action(message) => { root.show-notice(message); }
                    }
                    if root.current-page == ViewPage.models: ModelsPage {
                        directory: root.models-directory;
                        entries: root.model-entries;
                        selected-index <=> root.selected-model;
                        details-height <=> root.pane-layout.models-details-height;
                        preview-action(message) => { root.show-notice(message); }
                    }
                    if root.current-page == ViewPage.preannotation: PreannotationPage {
                        editor-width <=> root.pane-layout.preannotation-editor-width;
                        analysis-ratio <=> root.pane-layout.preannotation-analysis-ratio;
                        draft <=> root.feature-draft;
                        analysis: root.feature-analysis;
                        rules: root.feature-rules;
                        confirmed: root.feature-confirmed;
                        request-analysis => {
                            if root.feature-draft.target == "" || root.feature-draft.appearance == "" {
                                root.show-notice("请填写识别目标和外观特征。");
                            } else { root.show-notice("Agent 分析暂不可用。"); }
                        }
                        confirm-rules => {
                            if root.feature-analysis == "" || root.feature-rules == "" {
                                root.show-notice("请先完成特征分析。");
                            } else { root.feature-confirmed = true; }
                        }
                        continue-annotation => {
                            if root.feature-confirmed { root.page-requested(ViewPage.annotation); }
                            else { root.show-notice("请先确认标注规则。"); }
                        }
                    }
                    if root.current-page == ViewPage.pretraining: PretrainingPage { }
                    if root.current-page == ViewPage.annotation: AnnotationPage {
                        list-width <=> root.pane-layout.annotation-list-width;
                        grid-mode <=> root.annotation-grid;
                        preview-action(message) => { root.show-notice(message); }
                    }
                    if root.current-page == ViewPage.training: TrainingPage {
                        parameters-width <=> root.pane-layout.training-parameters-width;
                        log-height <=> root.pane-layout.training-log-height;
                        loss-ratio <=> root.pane-layout.training-loss-ratio;
                        draft <=> root.training-draft;
                        preview-action(message) => { root.show-notice(message); }
                    }
                    if root.current-page == ViewPage.settings: SettingsPage {
                        preview-action(message) => { root.show-notice(message); }
                    }
                    if root.current-page == ViewPage.about: AboutPage { }
                }
            }

            agent-splitter := Splitter {
                x: parent.width - 32px - self.position;
                y: 0px;
                width: 16px;
                height: parent.height;
                vertical: true;
                reverse: true;
                thickness: 16px;
                label: "Agent 宽度";
                value: root.pane-layout.agent-width < 0px ? (root.width - 64px - navigation-splitter.position) / 3 : root.pane-layout.agent-width;
                minimum: 260px;
                maximum: root.width - 64px - navigation-splitter.position - 540px;
                resized(size) => { root.pane-layout.agent-width = size; }
            }

            GlobalChat {
                x: parent.width - 16px - agent-splitter.position;
                y: 0px;
                height: parent.height;
                width: agent-splitter.position;
                composer-height <=> root.pane-layout.chat-composer-height;
                context-label: root.page-label;
                draft <=> root.chat-draft;
                last-message: root.last-message;
                clear-history => { root.last-message = ""; }
                send-message(message) => {
                    root.last-message = message;
                    root.chat-draft = "";
                    root.show-notice("Agent 未连接，消息未发送。");
                }
            }
        }
    }
    // Action feedback is transient and absent when idle; there is no permanent status footer.
    if root.feedback != "": GlassPanel {
        width: min(480px, root.width - 32px);
        height: 56px;
        x: (root.width - self.width) / 2;
        y: root.height - self.height - 16px;
        background: Theme.glass-strong;
        TouchArea { }

        HorizontalLayout {
            padding-left: 16px;
            padding-right: 10px;
            spacing: 12px;
            cross-axis-alignment: center;
            Text {
                text: root.feedback;
                color: Theme.text;
                font-size: 0.86rem;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }

            IconButton {
                label: "关闭提示";
                icon: @image-url("resources/ui/icons/close.svg");
                activated => { root.feedback = ""; notice-timer.stop(); }
            }
        }
    }
    // Render above all pages, so tool hints are not clipped by translucent panels.
    if UiHints.text != "": Rectangle {
        x: min(UiHints.x, root.width - self.width - 12px);
        y: min(UiHints.y, root.height - self.height - 12px);
        width: hint-label.preferred-width + 20px;
        height: 28px;
        background: Theme.text;
        border-radius: 6px;
        hint-label := Text {
            text: UiHints.text;
            color: white;
            font-size: 0.76rem;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
