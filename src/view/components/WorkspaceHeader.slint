import { Theme } from "../ui_items/Theme.slint";

export component WorkspaceHeader inherits Rectangle {
    in property <string> title;
    in property <image> icon;
    // Shared with Agent: 34px title row, 16px spacing and a 1px separator.
    height: 51px;
    VerticalLayout {
        spacing: 16px;
        HorizontalLayout {
            height: 34px;
            spacing: 8px;
            cross-axis-alignment: center;
            Image {
                source: root.icon;
                width: 18px;
                height: 18px;
                colorize: Theme.accent;
            }

            Text {
                text: root.title;
                color: Theme.text;
                font-size: 1.1rem;
                font-weight: 600;
                horizontal-stretch: 1;
            }

            @children
        }

        Rectangle {
            height: 1px;
            background: Theme.border;
        }
    }
}
