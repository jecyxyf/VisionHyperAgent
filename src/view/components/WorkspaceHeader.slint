import { Theme } from "../Theme.slint";

export component WorkspaceHeader inherits Rectangle {
    in property <string> title;
    height: 54px;
    HorizontalLayout {
        padding-left: 4px; spacing: 12px;
        cross-axis-alignment: center;
        Text { text: root.title; color: Theme.text; font-size: 1.55rem; font-weight: 700; }
        Rectangle { horizontal-stretch: 1; }
        @children
    }
}
