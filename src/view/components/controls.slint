import { Theme, UiHints } from "../theme.slint";

export component GlassPanel inherits Rectangle {
    background: Theme.glass;
    border-radius: 22px;
    border-width: 1px;
    border-color: Theme.glass-edge;
    drop-shadow-blur: 30px;
    drop-shadow-offset-y: 8px;
    drop-shadow-color: Theme.shadow;
    Rectangle {
        x: 18px; y: 1px; width: parent.width - 36px; height: 1px;
        background: Theme.edge-highlight;
    }
    Rectangle {
        x: 18px; y: parent.height - 2px; width: parent.width - 36px; height: 1px;
        background: Theme.edge-highlight;
    }
    @children
}

export component IconButton inherits FocusScope {
    in property <string> label;
    in property <image> icon;
    in property <bool> primary: false;
    in property <bool> selected: false;
    callback activated();
    width: 34px;
    height: 34px;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.activated(); }
    key-pressed(event) => {
        if event.text == "\n" || event.text == " " {
            root.activated();
            return accept;
        }
        return reject;
    }
    Rectangle {
        y: hit.pressed ? 1px : 0px;
        width: root.width; height: root.height;
        border-radius: 11px;
        background: root.primary ? Theme.action-gradient :
            (hit.pressed || root.selected ? Theme.selection-gradient :
            (hit.has-hover ? Theme.elevated : Theme.surface));
        border-width: 1px;
        border-color: root.has-focus ? Theme.accent : Theme.glass-edge;
        drop-shadow-blur: hit.pressed ? 4px : (root.primary || root.selected ? 13px : 0px);
        drop-shadow-offset-y: hit.pressed ? 1px : 4px;
        drop-shadow-color: root.primary || root.selected ? Theme.action-shadow : transparent;
        animate y { duration: 80ms; }
        Image {
            width: 17px; height: 17px;
            source: root.icon;
            colorize: root.primary ? white : (root.selected ? Theme.accent : Theme.muted);
        }
        hit := TouchArea {
            mouse-cursor: pointer;
            changed has-hover => {
                if self.has-hover {
                    UiHints.text = root.label;
                    UiHints.x = root.absolute-position.x;
                    UiHints.y = root.absolute-position.y + root.height + 8px;
                } else if UiHints.text == root.label {
                    UiHints.text = "";
                }
            }
            clicked => { root.focus(); root.activated(); }
        }
    }
}

export component NavItem inherits FocusScope {
    in property <string> text;
    in property <image> icon;
    in property <bool> selected: false;
    in property <bool> nested: false;
    callback activated();
    height: 40px;
    accessible-role: button;
    accessible-label: root.nested ? "模型 / " + root.text : root.text;
    accessible-action-default => { root.activated(); }
    key-pressed(event) => {
        if event.text == "\n" || event.text == " " {
            root.activated(); return accept;
        }
        return reject;
    }
    Rectangle {
        border-radius: 12px;
        background: root.selected ? Theme.action-gradient : (hit.has-hover ? Theme.elevated : transparent);
        border-width: 1px;
        border-color: root.has-focus ? Theme.accent : (root.selected ? Theme.glass-edge : transparent);
        drop-shadow-blur: root.selected ? 18px : 0px;
        drop-shadow-offset-y: 2px;
        drop-shadow-color: root.selected ? Theme.action-shadow : transparent;
        HorizontalLayout {
            padding-left: root.nested ? 35px : 12px;
            padding-right: 12px;
            spacing: 10px;
            cross-axis-alignment: center;
            if !root.nested: Image {
                width: 17px; height: 17px; source: root.icon;
                colorize: root.selected ? white : Theme.muted;
            }
            if root.nested: Rectangle {
                width: 4px; height: 4px; border-radius: 2px;
                background: root.selected ? white : Theme.border;
            }
            Text {
                text: root.text; color: root.selected ? white : Theme.muted;
                font-size: 1rem; font-weight: root.selected ? 600 : 500;
                vertical-alignment: center; horizontal-stretch: 1;
            }
            if root.selected: Rectangle { width: 3px; height: 14px; border-radius: 2px; background: #ffffffcf; }
        }
        hit := TouchArea { mouse-cursor: pointer; clicked => { root.focus(); root.activated(); } }
    }
}

// One visual surface, two independent accessible actions: open the page or fold its children.
export component ExpandableNavItem inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> selected;
    in property <bool> expanded;
    callback activated();
    callback toggle-expanded();
    private property <string> fold-label: (root.expanded ? "折叠" : "展开") + root.text + "子页面";
    height: 40px;
    border-radius: 12px;
    background: root.selected ? Theme.action-gradient :
        (body-hit.has-hover || arrow-hit.has-hover ? Theme.elevated : transparent);
    border-width: 1px;
    border-color: body.has-focus || disclosure.has-focus ? Theme.accent :
        (root.selected ? Theme.glass-edge : transparent);
    drop-shadow-blur: root.selected ? 18px : 0px;
    drop-shadow-offset-y: 2px;
    drop-shadow-color: root.selected ? Theme.action-shadow : transparent;
    HorizontalLayout {
        spacing: 0px;
        body := FocusScope {
            horizontal-stretch: 1;
            accessible-role: button; accessible-label: root.text;
            accessible-action-default => { root.activated(); }
            key-pressed(event) => {
                if event.text == "\n" || event.text == " " { root.activated(); return accept; }
                return reject;
            }
            HorizontalLayout {
                padding-left: 12px; spacing: 10px;
                cross-axis-alignment: center;
                Image { width: 17px; height: 17px; source: root.icon; colorize: root.selected ? white : Theme.muted; }
                Text {
                    text: root.text; color: root.selected ? white : Theme.muted;
                    font-size: 1rem; font-weight: root.selected ? 600 : 500;
                    vertical-alignment: center; horizontal-stretch: 1;
                }
            }
            body-hit := TouchArea { mouse-cursor: pointer; clicked => { body.focus(); root.activated(); } }
        }
        disclosure := FocusScope {
            width: 30px;
            accessible-role: button; accessible-label: root.fold-label;
            accessible-action-default => { root.toggle-expanded(); }
            key-pressed(event) => {
                if event.text == "\n" || event.text == " " { root.toggle-expanded(); return accept; }
                return reject;
            }
            Image {
                width: 14px; height: 14px;
                source: root.expanded ? @image-url("../resources/ui/icons/chevron.svg") : @image-url("../resources/ui/icons/next.svg");
                colorize: root.selected ? white : (disclosure.has-focus ? Theme.accent : Theme.muted);
            }
            // Keyboard focus remains visible without a permanent second button outline.
            if disclosure.has-focus: Rectangle {
                x: 9px; y: parent.height - 7px; width: 12px; height: 2px; border-radius: 1px;
                background: root.selected ? white : Theme.accent;
            }
            arrow-hit := TouchArea {
                mouse-cursor: pointer;
                changed has-hover => {
                    if self.has-hover {
                        UiHints.text = root.fold-label;
                        UiHints.x = root.absolute-position.x;
                        UiHints.y = root.absolute-position.y + root.height + 8px;
                    } else if UiHints.text == root.fold-label { UiHints.text = ""; }
                }
                clicked => { disclosure.focus(); root.toggle-expanded(); }
            }
        }
    }
}

export component ToolbarDivider inherits Rectangle {
    width: 1px; height: 18px; background: Theme.border;
}

export component StatusPill inherits Rectangle {
    in property <string> text;
    width: 74px;
    height: 24px;
    border-radius: 12px;
    background: Theme.field-gradient;
    border-width: 1px; border-color: Theme.glass-edge;
    HorizontalLayout {
        padding-left: 9px; padding-right: 9px; spacing: 6px;
        cross-axis-alignment: center;
        Rectangle { width: 4px; height: 4px; border-radius: 2px; background: Theme.subdued; }
        Text { text: root.text; color: Theme.muted; font-size: 0.76rem; vertical-alignment: center; }
    }
}

export component InfoRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    height: 44px;
    HorizontalLayout {
        padding-left: 16px; padding-right: 16px;
        cross-axis-alignment: center;
        Text { text: root.label; color: Theme.muted; font-size: 0.88rem; horizontal-stretch: 1; }
        Text { text: root.value; color: Theme.text; font-size: 0.86rem; }
    }
    Rectangle { x: 16px; y: parent.height - 1px; width: parent.width - 32px; height: 1px; background: Theme.border; }
}

export component DraftField inherits Rectangle {
    in property <string> label;
    in property <string> placeholder: "由 Agent 建议";
    in-out property <string> value;
    height: 66px;
    VerticalLayout {
        spacing: 6px;
        Text { text: root.label; color: Theme.muted; font-size: 0.82rem; }
        Rectangle {
            height: 34px;
            background: Theme.field-gradient; border-radius: 10px;
            border-width: 1px; border-color: field.has-focus ? Theme.accent : Theme.border;
            HorizontalLayout {
                padding-left: 10px; padding-right: 10px;
                field := TextInput {
                    text <=> root.value; single-line: true;
                    color: Theme.text; font-size: 0.88rem;
                    vertical-alignment: center; accessible-label: root.label;
                }
            }
            if root.value == "": Text {
                x: 10px; y: 0; height: parent.height;
                text: root.placeholder; color: Theme.subdued; font-size: 0.83rem;
                vertical-alignment: center;
            }
        }
    }
}
