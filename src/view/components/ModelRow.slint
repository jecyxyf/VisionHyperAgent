import { ModelEntry } from "../ui_items/ViewTypes.slint";
import { Theme } from "../ui_items/Theme.slint";
import { ModelCells } from "ModelCells.slint";

export component ModelRow inherits FocusScope {
    in property <ModelEntry> entry;
    in property <bool> selected;
    callback activated();
    height: 54px;
    accessible-role: button;
    accessible-label: root.entry.name + "，" + root.entry.format + "，" + root.entry.path;
    accessible-action-default => { root.activated(); }
    key-pressed(event) => {
        if event.text == "\n" || event.text == " " {
            root.activated(); return accept;
        }
        return reject;
    }
    Rectangle {
        border-radius: 11px;
        border-width: 1px; border-color: root.has-focus ? Theme.accent : transparent;
        background: root.selected ? Theme.selection-gradient : (hit.has-hover ? Theme.surface : transparent);
        ModelCells { entry: root.entry; }
        hit := TouchArea { mouse-cursor: pointer; clicked => { root.focus(); root.activated(); } }
    }
}
