import { Theme } from "../Theme.slint";

export component GlassPanel inherits Rectangle {
    background: Theme.glass;
    border-radius: 22px;
    border-width: 1px;
    border-color: Theme.glass-edge;
    drop-shadow-blur: 30px;
    drop-shadow-offset-y: 8px;
    drop-shadow-color: Theme.shadow;
    Rectangle {
        x: 18px; y: 1px; width: parent.width - 36px; height: 1px;
        background: Theme.edge-highlight;
    }
    Rectangle {
        x: 18px; y: parent.height - 2px; width: parent.width - 36px; height: 1px;
        background: Theme.edge-highlight;
    }
    @children
}
