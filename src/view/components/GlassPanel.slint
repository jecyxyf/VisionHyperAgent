import { Theme } from "../Theme.slint";

export component GlassPanel inherits Rectangle {
    in property <bool> inset: false;
    background: root.inset ? Theme.surface : Theme.glass;
    border-radius: 22px;
    border-width: 1px;
    border-color: root.inset ? Theme.border : Theme.glass-edge;
    drop-shadow-blur: root.inset ? 0px : 30px;
    drop-shadow-offset-y: 8px;
    drop-shadow-color: root.inset ? transparent : Theme.shadow;
    Rectangle {
        visible: !root.inset;
        x: 18px;
        y: 1px;
        width: parent.width - 36px;
        height: 1px;
        background: Theme.edge-highlight;
    }

    Rectangle {
        visible: !root.inset;
        x: 18px;
        y: parent.height - 2px;
        width: parent.width - 36px;
        height: 1px;
        background: Theme.edge-highlight;
    }

    @children
}
