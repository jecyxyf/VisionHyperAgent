import { Theme } from "../Theme.slint";
import { UiHints } from "../UiHints.slint";

export component IconButton inherits FocusScope {
    in property <string> label;
    in property <image> icon;
    in property <bool> primary: false;
    in property <bool> selected: false;
    callback activated();
    width: 34px;
    height: 34px;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.activated(); }
    key-pressed(event) => {
        if event.text == "\n" || event.text == " " {
            root.activated();
            return accept;
        }
        return reject;
    }
    Rectangle {
        y: hit.pressed ? 1px : 0px;
        width: root.width; height: root.height;
        border-radius: 11px;
        background: root.primary ? Theme.action-gradient :
            (hit.pressed || root.selected ? Theme.selection-gradient :
            (hit.has-hover ? Theme.elevated : Theme.surface));
        border-width: 1px;
        border-color: root.has-focus ? Theme.accent : Theme.glass-edge;
        drop-shadow-blur: hit.pressed ? 4px : (root.primary || root.selected ? 13px : 0px);
        drop-shadow-offset-y: hit.pressed ? 1px : 4px;
        drop-shadow-color: root.primary || root.selected ? Theme.action-shadow : transparent;
        animate y { duration: 80ms; }
        Image {
            width: 17px; height: 17px;
            source: root.icon;
            colorize: root.primary ? white : (root.selected ? Theme.accent : Theme.muted);
        }
        hit := TouchArea {
            mouse-cursor: pointer;
            changed has-hover => {
                if self.has-hover {
                    UiHints.text = root.label;
                    UiHints.x = root.absolute-position.x;
                    UiHints.y = root.absolute-position.y + root.height + 8px;
                } else if UiHints.text == root.label {
                    UiHints.text = "";
                }
            }
            clicked => { root.focus(); root.activated(); }
        }
    }
}
