import { GlassPanel } from "GlassPanel.slint";
import { Theme } from "../Theme.slint";
import { IconButton } from "IconButton.slint";
import { ScrollView } from "std-widgets.slint";

export component GlobalChat inherits GlassPanel {
    in property <string> context-label;
    in-out property <string> draft;
    in property <string> last-message;
    callback send-message(string);
    callback clear-history();
    VerticalLayout {
        padding: 18px; spacing: 16px;
        HorizontalLayout {
            height: 34px; spacing: 8px; cross-axis-alignment: center;
            Image { source: @image-url("../resources/ui/icons/spark.svg"); width: 18px; height: 18px; colorize: Theme.accent; }
            Text { text: "Agent"; color: Theme.text; font-size: 1.1rem; font-weight: 600; horizontal-stretch: 1; }
            IconButton { label: "清除聊天记录"; icon: @image-url("../resources/ui/icons/trash.svg"); activated => { root.clear-history(); } }
        }
        Rectangle { height: 1px; background: Theme.border; }
        ScrollView {
            vertical-stretch: 1;
            viewport-width: self.width;
            VerticalLayout {
                spacing: 16px;
                if root.last-message != "": Rectangle {
                    background: Theme.selection-gradient; border-radius: 14px;
                    VerticalLayout {
                        padding: 12px; spacing: 10px;
                        Text { text: root.last-message; color: Theme.text; font-size: 0.86rem; wrap: word-wrap; }
                        Text { text: "未发送"; color: Theme.muted; font-size: 0.76rem; }
                    }
                }
                Rectangle { vertical-stretch: 1; }
            }
        }
        Rectangle {
            height: 132px; border-radius: 16px;
            background: Theme.field-gradient; border-width: 1px;
            border-color: input.has-focus ? Theme.accent : Theme.border;
            VerticalLayout {
                padding: 12px; spacing: 10px;
                Rectangle {
                    vertical-stretch: 1;
                    if root.draft == "": Text { x: 0; y: 0; text: "输入消息…"; color: Theme.subdued; font-size: 0.86rem; }
                    input := TextInput {
                        x: 0; y: 0; width: 100%; height: 100%;
                        text <=> root.draft; color: Theme.text; font-size: 0.87rem;
                        single-line: false; wrap: word-wrap; accessible-label: "消息输入";
                    }
                }
                HorizontalLayout {
                    cross-axis-alignment: center;
                    Rectangle { horizontal-stretch: 1; }
                    IconButton {
                        label: "发送消息"; icon: @image-url("../resources/ui/icons/send.svg"); primary: true;
                        activated => { if root.draft != "" { root.send-message(root.draft); } }
                    }
                }
            }
        }
    }
}
