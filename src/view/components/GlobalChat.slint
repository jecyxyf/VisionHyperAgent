import { WorkspaceHeader } from "WorkspaceHeader.slint";
import { SplitArea } from "../ui_items/SplitArea.slint";
import { Splitter } from "../ui_items/Splitter.slint";
import { GlassPanel } from "GlassPanel.slint";
import { Theme } from "../ui_items/Theme.slint";
import { IconButton } from "IconButton.slint";
import { ScrollView } from "std-widgets.slint";

export component GlobalChat inherits GlassPanel {
    in property <string> context-label;
    in-out property <string> draft;
    in-out property <length> composer-height: 132px;
    in property <string> last-message;
    callback send-message(string);
    callback clear-history();
    VerticalLayout {
        padding: 18px;
        spacing: 16px;
        WorkspaceHeader {
            title: "Agent";
            icon: @image-url("../resources/ui/icons/spark.svg");
            IconButton {
                label: "清除聊天记录";
                icon: @image-url("../resources/ui/icons/trash.svg");
                activated => { root.clear-history(); }
            }
        }

        chat-body := SplitArea {
            vertical-stretch: 1;

            ScrollView {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: max(0px, parent.height - 16px - composer-splitter.position);

                viewport-width: self.width;
                VerticalLayout {
                    spacing: 16px;
                    if root.last-message != "": Rectangle {
                        background: Theme.selection-gradient;
                        border-radius: 14px;
                        VerticalLayout {
                            padding: 12px;
                            spacing: 10px;
                            Text {
                                text: root.last-message;
                                color: Theme.text;
                                font-size: 0.86rem;
                                wrap: word-wrap;
                            }

                            Text {
                                text: "未发送";
                                color: Theme.muted;
                                font-size: 0.76rem;
                            }
                        }
                    }
                    Rectangle {
                        vertical-stretch: 1;
                    }
                }
            }

            composer-splitter := Splitter {
                x: 0px;
                y: parent.height - 16px - self.position;
                width: parent.width;
                height: 16px;
                thickness: 16px;
                reverse: true;
                label: "聊天输入区高度";
                value: root.composer-height;
                minimum: 108px;
                maximum: chat-body.height - 16px - 120px;
                resized(size) => { root.composer-height = size; }
            }

            Rectangle {
                x: 0px;
                y: parent.height - composer-splitter.position;
                width: parent.width;
                height: composer-splitter.position;
                border-radius: 16px;
                background: Theme.field-gradient;
                border-width: 1px;
                border-color: input.has-focus ? Theme.accent : Theme.border;
                VerticalLayout {
                    padding: 12px;
                    spacing: 10px;
                    Rectangle {
                        vertical-stretch: 1;
                        if root.draft == "": Text {
                            x: 0;
                            y: 0;
                            text: "输入消息…";
                            color: Theme.subdued;
                            font-size: 0.86rem;
                        }
                        input := TextInput {
                            x: 0;
                            y: 0;
                            width: 100%;
                            height: 100%;
                            text <=> root.draft;
                            color: Theme.text;
                            font-size: 0.87rem;
                            single-line: false;
                            wrap: word-wrap;
                            accessible-label: "消息输入";
                        }
                    }

                    HorizontalLayout {
                        cross-axis-alignment: center;
                        Rectangle {
                            horizontal-stretch: 1;
                        }

                        IconButton {
                            label: "发送消息";
                            icon: @image-url("../resources/ui/icons/send.svg");
                            primary: true;
                            activated => { if root.draft != "" { root.send-message(root.draft); } }
                        }
                    }
                }
            }
        }
    }
}
