import { Theme } from "../theme.slint";

export component WorkspaceHeader inherits Rectangle {
    in property <string> title;
    height: 54px;
    HorizontalLayout {
        padding-left: 4px; spacing: 12px;
        cross-axis-alignment: center;
        Text { text: root.title; color: Theme.text; font-size: 1.55rem; font-weight: 700; }
        Rectangle { horizontal-stretch: 1; }
        @children
    }
}

export component EmptyState inherits Rectangle {
    in property <image> icon;
    in property <string> title;
    in property <string> detail;
    VerticalLayout {
        alignment: center; spacing: 12px; padding: 16px;
        Rectangle {
            height: 60px;
            Rectangle {
                width: 60px; height: 60px; border-radius: 18px;
                background: Theme.selection-gradient; border-width: 1px; border-color: Theme.glass-edge;
                Image { width: 26px; height: 26px; source: root.icon; colorize: Theme.action-gradient; }
            }
        }
        Text { text: root.title; color: Theme.muted; font-size: 1rem; font-weight: 500; horizontal-alignment: center; wrap: word-wrap; }
        if root.detail != "": Text { text: root.detail; color: Theme.subdued; font-size: 0.82rem; horizontal-alignment: center; wrap: word-wrap; }
    }
}

export component GridCanvas inherits Rectangle {
    border-radius: 14px;
    background: Theme.canvas;
    border-width: 1px; border-color: Theme.border;
    clip: true;
    for i in 36: Rectangle { x: i * 32px; y: 0; width: 1px; height: parent.height; background: Theme.grid; }
    for i in 36: Rectangle { x: 0; y: i * 32px; width: parent.width; height: 1px; background: Theme.grid; }
    @children
}

export component EmptyChart inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    background: Theme.field-gradient; border-radius: 14px;
    border-width: 1px; border-color: Theme.border;
    VerticalLayout {
        padding: 18px; spacing: 16px;
        HorizontalLayout {
            Text { text: root.title; color: Theme.text; font-size: 0.88rem; font-weight: 500; }
            Rectangle { horizontal-stretch: 1; }
        }
        plot := Rectangle {
            vertical-stretch: 1;
            for i in 5: Rectangle { x: 0; y: i * (parent.height - 1px) / 4; height: 1px; width: parent.width; background: Theme.grid; }
            for i in 7: Rectangle { y: 0; x: i * (parent.width - 1px) / 6; width: 1px; height: parent.height; background: Theme.grid; }
            Text { text: root.detail; color: Theme.subdued; font-size: 0.82rem; horizontal-alignment: center; vertical-alignment: center; }
        }
        Text { text: "Epoch"; color: Theme.subdued; font-size: 0.72rem; horizontal-alignment: right; }
    }
}
